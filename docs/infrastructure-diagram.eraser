// Pocket Trash Infrastructure
// Generated by `pnpm diagram:infra` from `docs/infrastructure-diagram.yaml`.
// Edit the YAML metadata, then rerun the generator.
direction right
colorMode pastel
styleMode plain
typeface clean

prod [color: green, label: "Production"] {
  prod_Web_Hosting [label: "Web Hosting"] {
    prod_web [color: black, icon: vercel, label: "apps/web\nTanStack Start"]
  }
  prod_API_Hosting [label: "API Hosting"] {
    prod_api [color: orange, icon: cloudflare, label: "apps/api\nCloudflare Worker"]
  }
  prod_Mobile_Release [label: "Mobile Release"] {
    prod_mobile [color: gray, icon: mobile, label: "apps/mobile\nExpo app"]
  }
  prod_Data [label: "Data"] {
    prod_neon [color: green, icon: postgresql, label: "Neon production branch"]
  }
  prod_Secrets [label: "Secrets"] {
    prod_infisical [color: purple, icon: lock, label: "Infisical prod secrets"]
  }
  prod_Observability [label: "Observability"] {
    prod_axiom [color: blue, icon: activity, label: "Axiom production dataset"]
  }
  prod_Identity [label: "Identity"] {
    prod_clerk [color: purple, icon: lock, label: "Clerk auth"]
  }
  prod_Mobile_Data [label: "Mobile Data"] {
    prod_firebase [color: yellow, icon: firebase, label: "Firebase / Firestore"]
  }
  prod_Distribution [label: "Distribution"] {
    prod_app_store [color: gray, icon: apple, label: "App Store Connect"]
    prod_google_play [color: green, icon: android, label: "Google Play"]
  }
  prod_Automation [label: "Automation"] {
    prod_github_actions [color: gray, icon: github, label: "release workflows"]
  }
  prod_Notifications [label: "Notifications"] {
    prod_discord [color: indigo, icon: message-circle, label: "Discord notifications"]
  }
}

prod_github_actions > prod_web: tag-triggered web deploy
prod_github_actions > prod_api: tag-triggered worker deploy
prod_github_actions > prod_mobile: mobile release
prod_github_actions > prod_discord: release and repo notifications
prod_infisical > prod_web: runtime secrets
prod_infisical > prod_api: worker secrets sync
prod_infisical > prod_mobile: release env
prod_web > prod_api: browser API + log proxy
prod_mobile > prod_api: version policy + log proxy
prod_web > prod_neon: server database access
prod_api > prod_neon: database access
prod_web > prod_clerk: web auth
prod_mobile > prod_clerk: mobile auth
prod_mobile > prod_firebase: Firestore sync
prod_web > prod_axiom: server logs
prod_api > prod_axiom: worker logs
prod_mobile > prod_app_store: iOS submit
prod_mobile > prod_google_play: Android submit

preview [color: blue, label: "Preview"] {
  preview_Web_Hosting [label: "Web Hosting"] {
    preview_web [color: black, icon: vercel, label: "apps/web\nVercel Preview"]
  }
  preview_API_Hosting [label: "API Hosting"] {
    preview_api [color: orange, icon: cloudflare, label: "apps/api\nWorker preview alias"]
  }
  preview_Mobile_Preview [label: "Mobile Preview"] {
    preview_mobile [color: gray, icon: mobile, label: "apps/mobile\nExpo preview build"]
  }
  preview_Data [label: "Data"] {
    preview_neon [color: green, icon: postgresql, label: "Neon PR branch or staging branch"]
  }
  preview_Secrets [label: "Secrets"] {
    preview_infisical [color: purple, icon: lock, label: "Infisical preview secrets"]
  }
  preview_Observability [label: "Observability"] {
