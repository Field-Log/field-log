dev_api > dev_axiom: optional worker logs

shared_packages [label: "Shared packages and detected runtime links", color: "gray"] {
  app_api [icon: box, label: "@app/api\napps/api"]
  app_mobile [icon: box, label: "@app/mobile\napps/mobile"]
  app_scraper [icon: box, label: "@app/scraper\napps/scraper"]
  app_web [icon: box, label: "@app/web\napps/web"]
  package_database [icon: package, label: "@package/database\npackages/database"]
  package_feature_flags [icon: package, label: "@package/feature-flags\npackages/feature-flags"]
  package_images [icon: package, label: "@package/images\npackages/images"]
  package_json_data [icon: package, label: "@package/json-data\npackages/json-data"]
  package_logger [icon: package, label: "@package/logger\npackages/logger"]
  package_markdown [icon: package, label: "@package/markdown\npackages/markdown"]
  package_services [icon: package, label: "@package/services\npackages/services"]
  package_theme [icon: package, label: "@package/theme\npackages/theme"]
  package_types [icon: package, label: "@package/types\npackages/types"]
  service_github_actions [color: gray, icon: github, label: "GitHub Actions"]
  service_vercel [color: black, icon: vercel, label: "Vercel"]
  service_cloudflare [color: orange, icon: cloudflare, label: "Cloudflare Workers"]
  service_neon [color: green, icon: postgresql, label: "Neon Postgres"]
  service_infisical [color: purple, icon: lock, label: "Infisical"]
  service_axiom [color: blue, icon: activity, label: "Axiom"]
  service_clerk [color: purple, icon: lock, label: "Clerk"]
  service_firebase [color: yellow, icon: firebase, label: "Firebase"]
  service_expo [color: gray, icon: mobile, label: "Expo / EAS / Fastlane"]
  service_app_store [color: gray, icon: apple, label: "App Store Connect"]
  service_google_play [color: green, icon: android, label: "Google Play"]
  service_discord [color: indigo, icon: message-circle, label: "Discord"]
  service_figjam [color: pink, icon: figma, label: "Figma / FigJam"]
}

