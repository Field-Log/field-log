app_web > app_api: source scan: VITE_API_URL -> /api/v0/logs
app_mobile > app_api: source scan: EXPO_PUBLIC_API_URL -> /api/v0/logs
app_mobile > app_api: source scan: EXPO_PUBLIC_API_URL -> /api/v0/mobile-version
app_web > service_clerk: source scan: Clerk web SDK
app_mobile > service_clerk: source scan: Clerk Expo SDK
app_mobile > service_firebase: source scan: Firebase / Firestore
app_web > service_axiom: source scan: createAxiomTransport
app_api > service_axiom: source scan: createAxiomTransport

legend [position: bottom-right] {
   [connection: >, label: "Runtime or deployment relationship"]
   [color: gray, label: "Shared code or tooling"]
   [color: green, label: "Production"]
   [color: blue, label: "Preview"]
   [color: yellow, label: "Development"]
}
