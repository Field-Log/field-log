  }
  preview_Identity [label: "Identity"] {
    preview_clerk [color: purple, icon: lock, label: "Clerk preview auth"]
  }
  preview_Mobile_Data [label: "Mobile Data"] {
    preview_firebase [color: yellow, icon: firebase, label: "Firebase / Firestore"]
  }
  preview_Automation [label: "Automation"] {
    preview_github_actions [color: gray, icon: github, label: "PR preview workflows"]
  }
}

preview_github_actions > preview_neon: prepare preview branch
preview_github_actions > preview_api: deploy Worker alias
preview_github_actions > preview_web: configure branch env
preview_infisical > preview_api: worker secrets sync
preview_infisical > preview_web: preview env
preview_infisical > preview_mobile: preview build env
preview_web > preview_api: PR API URL + log proxy
preview_mobile > preview_api: preview API URL
preview_web > preview_neon: server database access
preview_api > preview_neon: database access
preview_web > preview_clerk: preview auth
preview_mobile > preview_clerk: preview auth
preview_mobile > preview_firebase: Firestore sync
preview_web > preview_axiom: server logs
preview_api > preview_axiom: worker logs

dev [color: yellow, label: "Development"] {
  dev_Local_Apps [label: "Local Apps"] {
    dev_web [color: black, icon: vercel, label: "apps/web\nlocalhost:4005"]
